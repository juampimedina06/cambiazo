{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@cambiazo/shared": ["../../packages/shared/src/index.ts"],
      "@cambiazo/shared/*": ["../../packages/shared/src/*"],
      "zod": ["../../packages/shared/node_modules/zod/lib/index.d.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}

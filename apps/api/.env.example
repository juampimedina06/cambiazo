# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL Multi-Tenant with RLS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cambiazo_dev?schema=public"

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-cambiazo-dev-change-in-production
JWT_EXPIRES_IN=7d

# Mercado Pago Integration
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=mp_webhook_secret_dev
MERCADO_PAGO_SANDBOX=true
# Optional public HTTPS URL (e.g. ngrok) for Mercado Pago webhooks:
# MERCADO_PAGO_WEBHOOK_URL=https://tu-tunel.ngrok-free.app/api/v1/webhooks/mercadopago
